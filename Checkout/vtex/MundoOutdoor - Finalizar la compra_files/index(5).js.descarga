/***/ "./react/i18n/locales/es/es-ar.json":
/***/ (function(module) {

module.exports = JSON.parse("{\"translation\":{\"¡Un momento!\":\"'¡Un momento!'\",\"Si cierra esta pantalla, perderá todos los datos que se hayan agregado.\":\"Si cierra esta pantalla, perderá todos los datos que se hayan agregado.\",\"Continuar con el pago\":\"Continuar con el pago\",\"Cerrar y cancelar pago\":\"Cerrar y cancelar pago\",\"¡Ocurrio un error!\":\"¡Ocurrio un error!\",\"Puede intentar generar el ticket nuevamente.\":\"Puede intentar generar el ticket nuevamente.\",\"Volver a opciones\":\"Volver a opciones\",\"Tiempo para el pago expiró.\":\"Tiempo para el pago expiró.\",\"Seleccione una opción de pago nuevamente.\":\"Seleccione una opción de pago nuevamente.\",\"Seleccione una opción.\":\"Seleccione una opción.\",\"Cerrar\":\"Cerrar\",\"¿Cómo prefieres pagar?\":\"¿Cómo prefieres pagar?\",\"El pago se acreditará en menos de 1 hora.\":\"El pago se acreditará en menos de 1 hora.\",\"El pago se acreditará de 1 a 2 días hábiles.\":\"El pago se acreditará de 1 a 2 días hábiles.\",\"El pago se acreditará al instante\":\"El pago se acreditará al instante\",\"También puedes pagar Farmacias del Ahorro y Casa Ley.\":\"También puedes pagar Farmacias del Ahorro y Casa Ley.\",\"También puedes pagar en Chedraui y Telecomm-Telégrafos.\":\"También puedes pagar en Chedraui y Telecomm-Telégrafos.\",\"También puedes pagar en 4-72 y Soluciones en Red de todo el país.\":\"También puedes pagar en 4-72 y Soluciones en Red de todo el país.\",\"El pago se acreditará al instante.\\nTambién puedes pagar en 4-72 y Soluciones en Red de todo el país.\":\"El pago se acreditará al instante. También puedes pagar en 4-72 y Soluciones en Red de todo el país.\",\"Volver al Sitio\":\"Volver al Sitio\",\"Puedes pagar en BBVA Continental, BCP, Interbank, Scotiabank y BanBif.\":\"Puedes pagar en BBVA Continental, BCP, Interbank, Scotiabank y BanBif.\",\"Puedes pagar en BBVA Continental, BCP, Interbank, Tambo, Scotiabank, BanBif, Kasnet, Western Union, FullCarga y en cualquier comercio que acepte PagoEfectivo.\":\"Puedes pagar en BBVA Continental, BCP, Interbank, Tambo, Scotiabank, BanBif, Kasnet, Western Union, FullCarga y en cualquier comercio que acepte PagoEfectivo.\",\"Complete the bank validation so your payment can be approved\":\"Completa la validación del banco para aprobar tu pago\",\"We are taking you to validate the card {{card}} with your bank\":\"Te estamos llevando a validar la tarjeta {{card}} con tu banco\",\"We need to confirm that you are the cardholder.\":\"Necesitamos confirmar que eres titular de la tarjeta.\",\"We are receiving the response from your bank\":\"Estamos recibiendo la respuesta de tu banco\",\"Please keep this page open. If you close it, you will not be able to resume the validation.\":\"Por favor, mantén abierta esta pestaña. Si la cierras, no podrás retomar la validación.\",\"Pay yape\":\"Paga\",\"and\":\"con\",\"cents\":\"céntimos\",\"cent\":\"céntimo\",\"with Yape\":\"con Yape\",\"Yape pay button\":\"Pagar\",\"check on yape if the option\":\"Verifica en Yape que la opción \\\"Compras por internet\\\" esté activada y que tu límite diario sea suficiente.\",\"Cell phone linked to Yape\":\"Celular asociado a Yape\",\"Enter the cell phone number\":\"Ingresa el número de celular\",\"Approval code\":\"Código de aprobación\",\"Find it in the Yape menu.\":\"Encuéntralo en el menú de Yape.\",\"Processed by Mercado Pago\":\"Procesado por Mercado Pago\",\"Something went wrong\":\"Ha ocurrido un error\",\"Your payment could not be processed.\\n Please try again or choose another payment method.\":\"No se pudo procesar tu pago. \\n Por favor, vuelve a intentarlo o elige otro medio de pago.\",\"Try again\":\"Intentar nuevamente\",\"Pay with another method\":\"Pagar con otro medio\",\"Pay\":\"Pagar\",\"Your payment could not be processed. Please try again or choose another payment method.\":\"No se pudo procesar tu pago. Por favor, vuelve a intentarlo o elige otro medio de pago.\",\"Fill out this field.\":\"Completa este campo.\",\"Enter the entire number.\":\"Ingresa el número completo.\",\"Enter only numbers.\":\"Ingresa solo números.\",\"Invalid data. Check it and try again.\":\"Dato inválido. Revísalo y vuélvelo a intentar.\",\"Invalid information. Please check and try again.\":\"Información inválida. Revisa y vuelve a intentarlo.\",\"Yape declined your payment\":\"Yape rechazó tu pago\",\"Your payment could not be processed. You can contact Yape to find out why or try again with this or another payment method.\":\"No se pudo procesar tu pago. Puedes comunicarte con Yape para saber los motivos o intentar nuevamente con este u otro medio de pago.\",\"We recommend contacting Yape to learn the reasons for the rejection. Please pay with another method or try again with Yape.\":\"Te recomendamos comunicarte con Yape para conocer los motivos del rechazo. Paga con otro medio o intenta nuevamente con Yape.\",\"Your payment was rejected because something went wrong. We recommend trying again or paying with another method.\":\"Tu pago fue rechazado porque hubo un error. Te recomendamos intentar nuevamente o pagar otro medio de pago.\",\"This payment exceeds your daily limit for online purchases with Yape. We recommend paying with another method or trying again tomorrow.\":\"Este pago excede tu límite diario para compras por internet con Yape. Te recomendamos usar otro medio de pago o volver a intentar mañana.\",\"After three incorrect approval codes, the payment can’t be done with Yape for your safety. Pay with another method or try again in 24 hours.\":\"Luego de 3 códigos de aprobación incorrectos, por tu seguridad, no se puede realizar el pago con Yape. Paga con otro medio o intenta nuevamente en 24 horas.\",\"Your payment is being processed. Please wait a few seconds.\":\"Tu pago esta siendo procesado. Por favor, aguarda unos segundos.\",\"This payment exceeds your daily limit for online purchases with Yape. We recommend paying with another method.\":\"Este pago excede tu límite diario para compras por internet con Yape. Te recomendamos usar otro medio de pago.\",\"You can pay with another method or try again with Yape.\":\"Paga con otro medio o intenta nuevamente con Yape.\",\"Your payment could not be processed. We recommend paying with another method.\":\"No se pudo procesar tu pago. Te recomendamos pagar con otro medio.\",\"Close payment modal\":\"Cerrar modal de pago\"}}");


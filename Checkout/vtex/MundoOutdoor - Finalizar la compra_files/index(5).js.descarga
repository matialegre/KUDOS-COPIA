/***/ "./react/i18n/locales/en/en-us.json":
/***/ (function(module) {

module.exports = JSON.parse("{\"translation\":{\"¡Un momento!\":\"Important!\",\"Si cierra esta pantalla, perderá todos los datos que se hayan agregado.\":\"If you close this window, you will lose any data that has been added.\",\"Continuar con el pago\":\"Continue payment\",\"Cerrar y cancelar pago\":\"Close and cancel payment\",\"¡Ocurrio un error!\":\"An error has occurred!\",\"Puede intentar generar el ticket nuevamente.\":\"You can try generating a ticket again.\",\"Volver a opciones\":\"Back options\",\"Tiempo para el pago expiró.\":\"Time for payment expired.\",\"Seleccione una opción de pago nuevamente.\":\"Reselect a payment option.\",\"Cerrar\":\"Close\",\"¿Cómo prefieres pagar?\":\"How do you prefer to pay?\",\"Seleccione una opción.\":\"Select an option\",\"El pago se acreditará en menos de 1 hora.\":\"The payment will be credited less than 1 hour.\",\"El pago se acreditará de 1 a 2 días hábiles.\":\"Payment will be credited in 1-2 working days.\",\"El pago se acreditará al instante\":\"Payment will be credited instantly\",\"También puedes pagar Farmacias del Ahorro y Casa Ley.\":\"You can also pay at Farmacias del Ahorro and Casa Ley.\",\"También puedes pagar en Chedraui y Telecomm-Telégrafos.\":\"You can also pay at Chedraui and Telecomm-Telégrafos.\",\"También puedes pagar en 4-72 y Soluciones en Red de todo el país.\":\"You can also pay at 4-72 and Soluciones en Red throughout the country.\",\"El pago se acreditará al instante.\\nTambién puedes pagar en 4-72 y Soluciones en Red de todo el país.\":\"Payment will be credited instantly. You can also pay at 4-72 and Soluciones en Red throughout the country.\",\"Volver al Sitio\":\"Back to site\",\"Puedes pagar en BBVA Continental, BCP, Interbank, Scotiabank y BanBif.\":\"You can pay at BBVA Continental, BCP, Interbank, Scotiabank and BanBif.\",\"Puedes pagar en BBVA Continental, BCP, Interbank, Tambo, Scotiabank, BanBif, Kasnet, Western Union, FullCarga y en cualquier comercio que acepte PagoEfectivo.\":\"You can pay at BBVA Continental, BCP, Interbank, Tambo, Scotiabank, BanBif, Kasnet, Western Union, FullCarga or any store that accepts PagoEfectivo.\",\"Complete the bank validation so your payment can be approved\":\"Complete the bank validation so your payment can be approved\",\"We are taking you to validate the card {{card}} with your bank\":\"We are taking you to validate the card {{card}} with your bank\",\"We need to confirm that you are the cardholder.\":\"We need to confirm that you are the cardholder.\",\"We are receiving the response from your bank\":\"We are receiving the response from your bank\",\"Please keep this page open. If you close it, you will not be able to resume the validation.\":\"Please keep this page open. If you close it, you will not be able to resume the validation.\",\"Pay yape\":\"Pay\",\"and\":\"and\",\"cents\":\"cents\",\"cent\":\"cent\",\"with Yape\":\"with Yape\",\"Yape pay button\":\"Pay\",\"check on yape if the option\":\"Verify in Yape that the option \\\"Compra por internet\\\" is activated and that the daily limit is enough.\",\"Cell phone linked to Yape\":\"Cell phone linked to Yape\",\"Enter the cell phone number\":\"Enter the cell phone number\",\"Approval code\":\"Approval code\",\"Find it in the Yape menu.\":\"Find it in the Yape menu.\",\"Processed by Mercado Pago\":\"Processed by Mercado Pago\",\"Something went wrong\":\"Something went wrong\",\"Your payment could not be processed.\\n Please try again or choose another payment method.\":\"Your payment could not be processed.\\n Please try again or choose another payment method.\",\"Try again\":\"Try again\",\"Pay with another method\":\"Pay with another method\",\"Pay\":\"Pay\",\"Your payment could not be processed. Please try again or choose another payment method.\":\"Your payment could not be processed. Please try again or choose another payment method.\",\"Fill out this field.\":\"Fill out this field.\",\"Enter the entire number.\":\"Enter the entire number.\",\"Enter only numbers.\":\"Enter only numbers.\",\"Invalid data. Check it and try again.\":\"Invalid data. Check it and try again.\",\"Invalid information. Please check and try again.\":\"Invalid information. Please check and try again.\",\"Yape declined your payment\":\"Yape declined your payment\",\"Your payment could not be processed. You can contact Yape to find out why or try again with this or another payment method.\":\"Your payment could not be processed. You can contact Yape to find out why or try again with this or another payment method.\",\"We recommend contacting Yape to learn the reasons for the rejection. Please pay with another method or try again with Yape.\":\"We recommend contacting Yape to learn the reasons for the rejection. Please pay with another method or try again with Yape.\",\"Your payment was rejected because something went wrong. We recommend trying again or paying with another method.\":\"Your payment was rejected because something went wrong. We recommend trying again or paying with another method.\",\"This payment exceeds your daily limit for online purchases with Yape. We recommend paying with another method or trying again tomorrow.\":\"This payment exceeds your daily limit for online purchases with Yape. We recommend paying with another method or trying again tomorrow.\",\"After three incorrect approval codes, the payment can’t be done with Yape for your safety. Pay with another method or try again in 24 hours.\":\"After three incorrect approval codes, the payment can’t be done with Yape for your safety. Pay with another method or try again in 24 hours.\",\"Your payment is being processed. Please wait a few seconds.\":\"Your payment is being processed. Please wait a few seconds.\",\"This payment exceeds your daily limit for online purchases with Yape. We recommend paying with another method.\":\"This payment exceeds your daily limit for online purchases with Yape. We recommend paying with another method.\",\"You can pay with another method or try again with Yape.\":\"You can pay with another method or try again with Yape.\",\"Your payment could not be processed. We recommend paying with another method.\":\"Your payment could not be processed. We recommend paying with another method.\",\"Close payment modal\":\"Close payment modal\"}}");


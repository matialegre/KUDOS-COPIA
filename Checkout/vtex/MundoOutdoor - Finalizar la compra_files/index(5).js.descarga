/***/ "./react/i18n/locales/pt/pt-br.json":
/***/ (function(module) {

module.exports = JSON.parse("{\"translation\":{\"¡Un momento!\":\"Um momento!\",\"Si cierra esta pantalla, perderá todos los datos que se hayan agregado.\":\"Se você fechar esta janela, perderá todos os dados que foram adicionados.\",\"Continuar con el pago\":\"Continuar pagamento\",\"Cerrar y cancelar pago\":\"Fechar e cancelar pagamento\",\"¡Ocurrio un error!\":\"Ocorreu um erro!\",\"Puede intentar generar el ticket nuevamente.\":\"Você pode tentar gerar um boleto novamente.\",\"Volver a opciones\":\"Voltar as opções\",\"Tiempo para el pago expiró.\":\"Tempo para pagamento expirado.\",\"Seleccione una opción de pago nuevamente.\":\"Selecione novamente uma opção de pagamento.\",\"Cerrar\":\"Fechar\",\"¿Cómo prefieres pagar?\":\"Como prefere pagar?\",\"Seleccione una opción.\":\"Selecione uma opção\",\"El pago se acreditará en menos de 1 hora.\":\"O pagamento será creditado em menos de 1 hora.\",\"El pago se acreditará de 1 a 2 días hábiles.\":\"O pagamento será creditado em 1-2 dias úteis.\",\"El pago se acreditará al instante\":\"O pagamento será creditado instantaneamente\",\"También puedes pagar Farmacias del Ahorro y Casa Ley.\":\"Você também pode pagar por Farmacias del Ahorro e Casa Ley.\",\"También puedes pagar en Chedraui y Telecomm-Telégrafos.\":\"Você também pode pagar em Chedraui e Telecomm-Telégrafos.\",\"También puedes pagar en 4-72 y Soluciones en Red de todo el país.\":\"Você também pode pagar em 4-72 e Soluciones en Red em todo o país.\",\"El pago se acreditará al instante.\\nTambién puedes pagar en 4-72 y Soluciones en Red de todo el país.\":\"O pagamento será creditado instantaneamente. Você também pode pagar em 4-72 e Soluciones en Red em todo o país.\",\"Volver al Sitio\":\"Voltar ao site\",\"Puedes pagar en BBVA Continental, BCP, Interbank, Scotiabank y BanBif.\":\"Pode pagar em BBVA Continental, BCP, Interbank, Scotiabank e BanBif.\",\"Puedes pagar en BBVA Continental, BCP, Interbank, Tambo, Scotiabank, BanBif, Kasnet, Western Union, FullCarga y en cualquier comercio que acepte PagoEfectivo.\":\"Pode pagar em BBVA Continental, BCP, Interbank, Tambo, Scotiabank, BanBif, Kasnet, Western Union, FullCarga e em qualquer comércio que aceite PagoEfectivo.\",\"Complete the bank validation so your payment can be approved\":\"Conclua a validação bancária para aprovar seu pagamento\",\"We are taking you to validate the card {{card}} with your bank\":\"Estamos levando você para validar o cartão {{card}} com seu banco\",\"We need to confirm that you are the cardholder.\":\"Precisamos confirmar que você é o titular do cartão.\",\"We are receiving the response from your bank\":\"Estamos recebendo a resposta do seu banco\",\"Please keep this page open. If you close it, you will not be able to resume the validation.\":\"Por favor, mantenha esta página aberta. Se você fechá-la, não poderá retomar a validação.\",\"Pay yape\":\"Pague\",\"and\":\"e\",\"cents\":\"centavos\",\"cent\":\"centavo\",\"with Yape\":\"com o Yape\",\"Yape pay button\":\"Pagar\",\"check on yape if the option\":\"Confira no Yape se a opção \\\"Compras por internet\\\" está ativada e se o seu limite diário é suficiente.\",\"Cell phone linked to Yape\":\"Celular vinculado ao Yape\",\"Enter the cell phone number\":\"Digite o número do celular\",\"Approval code\":\"Código de aprovação\",\"Find it in the Yape menu.\":\"Ele está disponível no menu do Yape.\",\"Processed by Mercado Pago\":\"Processado pelo Mercado Pago\",\"Something went wrong\":\"Ocorreu um erro\",\"Your payment could not be processed.\\n Please try again or choose another payment method.\":\"Não foi possível processar seu pagamento. \\n Por favor, tente novamente ou escolha outro meio de pagamento.\",\"Try again\":\"Tentar novamente\",\"Pay with another method\":\"Pagar com outro meio\",\"Pay\":\"Pagar\",\"Your payment could not be processed. Please try again or choose another payment method.\":\"Não foi possível processar seu pagamento. Por favor, tente novamente ou escolha outro meio de pagamento.\",\"Fill out this field.\":\"Preencha este campo.\",\"Enter the entire number.\":\"Insira o número completo.\",\"Enter only numbers.\":\"Insira apenas números.\",\"Invalid data. Check it and try again.\":\"Dado inválido. Por favor, revise e tente novamente.\",\"Invalid information. Please check and try again.\":\"Informações inválidas. Revise-as e tente novamente.\",\"Yape declined your payment\":\"O Yape recusou seu pagamento\",\"Your payment could not be processed. You can contact Yape to find out why or try again with this or another payment method.\":\"Não foi possível processar seu pagamento. Você pode entrar em contato com Yape para saber os motivos ou tentar novamente com este ou outro meio de pagamento.\",\"We recommend contacting Yape to learn the reasons for the rejection. Please pay with another method or try again with Yape.\":\"Recomendamos entrar em contato com o Yape para saber os motivos da recusa. Use outro meio de pagamento ou tente novamente com o Yape.\",\"Your payment was rejected because something went wrong. We recommend trying again or paying with another method.\":\"Seu pagamento foi recusado devido a um erro. Recomendamos que você tente novamente ou pague com outro meio.\",\"This payment exceeds your daily limit for online purchases with Yape. We recommend paying with another method or trying again tomorrow.\":\"Este pagamento excede seu limite diário para compras online com o Yape. Recomendamos que você pague com outro meio ou tente novamente amanhã.\",\"After three incorrect approval codes, the payment can’t be done with Yape for your safety. Pay with another method or try again in 24 hours.\":\"Por segurança, não é possível pagar com o Yape após inserir os códigos de aprovação incorretamente 3 vezes. Pague com outro meio ou tente novamente em 24 horas.\",\"Your payment is being processed. Please wait a few seconds.\":\"Seu pagamento está sendo processado. Aguarde alguns segundos.\",\"This payment exceeds your daily limit for online purchases with Yape. We recommend paying with another method.\":\"Este pagamento excede seu limite diário para compras online com o Yape. Recomendamos que você pague com outro meio.\",\"You can pay with another method or try again with Yape.\":\"Pague com outro meio ou tente novamente com o Yape.\",\"Your payment could not be processed. We recommend paying with another method.\":\"Não foi possível processar seu pagamento. Recomendamos que você pague com outro meio.\",\"Close payment modal\":\"Fechar modal de pagamento\"}}");


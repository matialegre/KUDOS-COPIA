___CSS_LOADER_EXPORT___.push([module.i, "/* Adress subtitle */\n\n.vtex-omnishipping-1-x-addressForm {\n  padding: 0;\n}\n\n.vtex-omnishipping-1-x-address {\n  margin-bottom: 24px;\n}\n\n.vtex-omnishipping-1-x-addressSummary {\n}\n\n.vtex-omnishipping-1-x-addressSummaryActive {\n}\n\n.vtex-omnishipping-1-x-addressSummaryActive .address-summary {\n  background: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='24' height='24'><path fill='%230176ff' d='M15.998,5.951L4,16.237V30c0,0.552,0.448,1,1,1h8v-8h6v8h8c0.552,0,1-0.448,1-1V16.238L15.998,5.951z M19,19 h-6v-5h6V19z'></path> <polygon fill='%230176ff' points='15.998,0.683 9,6.682 9,3 5,3 5,10.111 0.59,13.892 1.892,15.41 15.998,3.317 30.108,15.41 31.41,13.892 '></polygon></svg>\")\n    no-repeat;\n  background-position: 12px 16px;\n  padding: 12px;\n  padding-left: 44px;\n  border: 1px solid #f4f4f4;\n  border-radius: 4px;\n  margin-bottom: 12px;\n}\n\n.vtex-omnishipping-1-x-addressSubtitle {\n  font-weight: 500;\n  font-size: 16px;\n}\n\n.vtex-omnishipping-1-x-deliveryTypesList {\n  margin-bottom: 15px;\n  width: 100%;\n}\n\n.vtex-omnishipping-1-x-deliveryTypesOption {\n  width: 50%;\n}\n\n.vtex-omnishipping-1-x-addressFormPart1 {\n  display: grid;\n}\n\n.vtex-omnishipping-1-x-addressFormPart1 .loading-inline.icon-spinner {\n  position: absolute;\n}\n\n.vtex-omnishipping-1-x-addressFormPart1 input:focus ~ span.help.error {\n  opacity: 0;\n  visibility: hidden;\n}\n\n.vtex-omnishipping-1-x-addressFormPart1 input {\n  width: 85px;\n  max-width: 85px;\n  transition: width 0.4s ease-in-out;\n}\n\np.input:not(.required) input.success:-moz-placeholder-shown {\n  background-image: none;\n}\n\np.input:not(.required) input.success:-ms-input-placeholder {\n  background-image: none;\n}\n\np.input:not(.required) input.success:placeholder-shown {\n  background-image: none;\n}\n\nselect.success {\n  background-image: url(/checkout/img/ico-ready.png);\n  background-position: right 10px top;\n  background-repeat: no-repeat;\n}\n\np.input:not(.required) input.success[value=''] {\n  background-image: none;\n}\n\n.vtex-omnishipping-1-x-addressFormPart1.vtex-omnishipping-1-x-geolocation input {\n  width: 270px;\n  max-width: unset;\n  transition: width 0.4s ease-in-out;\n}\n\n.vtex-omnishipping-1-x-addressFormPart1 .loading-postal-code {\n  width: 85px;\n  max-width: 85px;\n}\n\n.vtex-omnishipping-1-x-addressFormPart1 small {\n  margin-left: 10px;\n}\n\n.ship-complement input {\n  width: 176px;\n}\n\n.ship-country select {\n  width: 100%;\n}\n\n.ship-checkboxNumber input {\n  margin-top: 27px;\n}\n\n@media (max-width: 490px) {\n  .ship-complement input {\n    width: 55%;\n  }\n}\n\n.ship-notApplicable {\n  flex: none;\n  display: flex;\n\n}\n\n.ship-checkboxNumberLabel {\n  display: flex;\n  flex-direction: row-reverse;\n  justify-content: space-between;\n  width: 32%;\n  margin-left: 8px;\n  margin-top: 24px;\n}\n\np.ship-number, p.ship-city {\n  margin-right: 10px;\n}\n\np.ship-number, p.ship-city, p.ship-state {\n  float: left;\n}\n\n.ship-notApplicable {\n  flex: none;\n  display: flex;\n\n}\n\n.ship-checkboxNumberLabel {\n  display: flex;\n  flex-direction: row-reverse;\n  justify-content: space-between;\n  width: 32%;\n  margin-left: 8px;\n  margin-top: 24px;\n}\n\n\np.ship-name, p.ship-reference, p.ship-commercial, p.ship-neighborhood {\n  clear: both;\n}\n\n.vtex-omnishipping-1-x-teste p.ship-receiverName {\n  display: none;\n}\n\n.vtex-omnishipping-1-x-slideUp-enter {\n  top: 100%;\n}\n\n.vtex-omnishipping-1-x-slideUp-enter.vtex-omnishipping-1-x-slideUp-enter-active {\n  transition: top 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);\n  top: 0;\n}\n\n.vtex-omnishipping-1-x-slideUp-leave {\n  top: 0;\n}\n\n.vtex-omnishipping-1-x-slideUp-leave.vtex-omnishipping-1-x-slideUp-leave-active {\n  transition: top 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n  top: 100%;\n}\n\n.vtex-omnishipping-1-x-Accordion-enter {\n  max-height: 0;\n  overflow: hidden;\n}\n\n.vtex-omnishipping-1-x-Accordion-enter.vtex-omnishipping-1-x-Accordion-enter-active {\n  transition: max-height 0.3s ease-in;\n  max-height: 300px;\n}\n\n.vtex-omnishipping-1-x-Accordion-leave {\n  max-height: 300px;\n}\n\n.vtex-omnishipping-1-x-Accordion-leave.vtex-omnishipping-1-x-Accordion-leave-active {\n  transition: max-height 0.3s ease-out;\n  max-height: 0;\n  overflow: hidden;\n}\n\n.vtex-omnishipping-1-x-slideLeft-enter {\n  position: fixed;\n  transform: translate3d(100vw, 0, 0);\n}\n\n.vtex-omnishipping-1-x-slideLeft-enter.vtex-omnishipping-1-x-slideLeft-enter-active {\n  transform: translate3d(100vw, 0, 0) translateX(-100%);\n  transition: transform 0.3s;\n}\n\n.vtex-omnishipping-1-x-slideLeft-leave {\n  transform: translate3d(100vw, 0, 0) translateX(-100%);\n  position: fixed;\n}\n\n.vtex-omnishipping-1-x-slideLeft-leave.vtex-omnishipping-1-x-slideLeft-leave-active {\n  transform: translate3d(100vw, 0, 0);\n  transition: transform 0.3s;\n}\n\n.vtex-omnishipping-1-x-opacity-enter {\n  opacity: 0.01;\n}\n\n.vtex-omnishipping-1-x-opacity-enter.vtex-omnishipping-1-x-opacity-enter-active {\n  opacity: 1;\n  transition: opacity 0.3s ease-in;\n}\n\n.vtex-omnishipping-1-x-opacity-leave {\n  opacity: 1;\n}\n\n.vtex-omnishipping-1-x-opacity-leave.vtex-omnishipping-1-x-opacity-leave-active {\n  opacity: 0.01;\n  transition: opacity 0.3s cubic-bezier(0.95, 0.05, 0.795, 0.035);\n}\n\n.vtex-omnishipping-1-x-img-arrow-down {\n  position: absolute;\n  bottom: -9px;\n  left: 50%;\n  margin-left: -9px;\n}\n\n.vtex-omnishipping-1-x-accordion-toggle .vtex-omnishipping-1-x-link-box-edit {\n  position: absolute;\n  right: -8px;\n  top: -8px;\n  padding: 4px 6px 2px;\n  border-radius: 0 6px;\n  background: #eee;\n  border-color: #eee;\n  color: #08c;\n  font-size: 14px;\n  opacity: 0.7;\n}\n\n.vtex-omnishipping-1-x-submitPaymentButton {\n  text-align: right;\n}\n\n.vtex-omnishipping-1-x-hr {\n  margin-bottom: 32px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #ccc;
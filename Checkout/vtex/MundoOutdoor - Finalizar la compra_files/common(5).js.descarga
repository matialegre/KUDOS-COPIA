___CSS_LOADER_EXPORT___.push([module.i, "/* main structue */\n\n.vtex-pickup-points-modal-3-x-pickupPoint {\n  background-color: #fff;\n  border: 1px solid #f4f4f4;\n  border-radius: 4px;\n}\n\n.pkpmodal-points-list .pickupPoint {\n  box-shadow: 0 2px 2px 0 rgba(221, 221, 221, 0.5);\n}\n\n.vtex-pickup-points-modal-3-x-pickupPointMain {\n  display: flex;\n  padding: 12px 10px 12px 0;\n}\n\n.vtex-pickup-points-modal-3-x-pickupPointMarker {\n  flex: none;\n}\n\n.marker-image {\n  height: 26px;\n}\n\n.vtex-pickup-points-modal-3-x-pickupPointInfo {\n  flex: 1 1 auto;\n  width: 96px;\n}\n\n/* marker */\n\n.vtex-pickup-points-modal-3-x-pickupPointMarker,\n.vtex-pickup-points-modal-3-x-pickupPointMarkerPostalCode {\n  vertical-align: top;\n  text-align: center;\n  width: 60px;\n}\n\n/* distance */\n\n.vtex-pickup-points-modal-3-x-pickupPointDistance {\n  font-size: 10px;\n  line-height: 1;\n  margin: 4px 0 0;\n}\n\n/* name */\n\n.vtex-pickup-points-modal-3-x-pickupPointName {\n  font-size: 16px;\n  font-weight: 700;\n}\n\n/* address */\n\n.vtex-pickup-points-modal-3-x-pickupPointAddress {\n  color: #666;\n  line-height: 1.5;\n}\n\n.pkpmodal-points-list .address-summary {\n  text-overflow: ellipsis;\n  overflow: hidden;\n  white-space: nowrap;\n}\n\n/* sla info */\n\n.vtex-pickup-points-modal-3-x-pickupPointSlaAvailability,\n.vtex-pickup-points-modal-3-x-pickupPointSlaAvailabilityPostalCode {\n  border-top: 1px solid #f4f4f4;\n  padding: 8px 8px 8px 60px;\n}\n\n.vtex-pickup-points-modal-3-x-pickupPointAvailability {\n  color: #c6840c;\n  display: inline-block;\n  margin-top: 12px;\n}\n\n.vtex-pickup-points-modal-3-x-pickupPointNoneAvailable {\n  color: #666666;\n  display: inline-block;\n  margin-top: 12px;\n}\n\n.vtex-pickup-points-modal-3-x-pickupPointPrice,\n.vtex-pickup-points-modal-3-x-pickupPointSla {\n  display: inline-block;\n  margin-right: 20px;\n  font-size: 12px;\n}\n\n.vtex-pickup-points-modal-3-x-pickupPointAddress .postalCode,\n.vtex-pickup-points-modal-3-x-pi
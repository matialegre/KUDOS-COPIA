{
    "store.custom#pagos-promociones": {
        "children": [
            "flex-layout.row#shared-container-pagos-promociones"
        ]
    },

    "flex-layout.row#shared-container-pagos-promociones": {
        "props": {
            "blockClass": "shared-container-constitucionales",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "left",
            "colSizing": "auto"
        },
        "children": [
            "flex-layout.col#shared-container-pagos-promociones-col"
        ]
    },

    "flex-layout.col#shared-container-pagos-promociones-col": {
        "props": {
            "blockClass": "shared-container-constitucionales-col",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "left",
            "colSizing": "auto"
        },
        "children": [
            "breadcrumb-custom",
            "rich-text#text-title-pagos-promociones",
            "rich-text#text-section-promociones-bancarias",
            "rich-text#text-subtitle-promociones-bancarias",
            "flex-layout.row#logos-promociones-bancarias",
            "rich-text#text-section-tarjetas-credito",
            "flex-layout.row#logos-tarjetas-credito",
            "rich-text#text-section-tarjetas-debito",
            "flex-layout.row#logos-tarjetas-debito",
            "flex-layout.row#promociones-habituales-otros-medios"
        ]
    },

    "rich-text#text-title-pagos-promociones": {
        "props": {
            "blockClass": "text-title-institucionales",
            "text": "Pagos y promociones"
        }
    },

    "rich-text#text-section-promociones-bancarias": {
        "props": {
            "blockClass": ["text-section-title-pagos", "first-section"],
            "text": "Promociones Bancarias"
        }
    },

    "rich-text#text-subtitle-promociones-bancarias": {
        "props": {
            "blockClass": "text-subtitle-pagos",
            "text": "Hacé clic en cada logo para conocer los detalles y vigencia de cada promoción"
        }
    },

    "flex-layout.row#logos-promociones-bancarias": {
        "props": {
            "blockClass": "logos-row-pagos",
            "preserveLayoutOnMobile": false,
            "colGap": 0,
            "horizontalAlign": "center"
        },
        "children": [
            "flex-layout.col#logo-banco-provincia",
            "flex-layout.col#logo-credicoop",
            "flex-layout.col#logo-bbva-modo",
            "flex-layout.col#logo-naranja-x",
            "flex-layout.col#logo-coopeplus"
        ]
    },

    "flex-layout.col#logo-banco-provincia": {
        "props": {
            "blockClass": "logo-card-pagos"
        },
        "children": [
            "image#banco-provincia",
            "rich-text#banco-provincia-text1",
            "rich-text#banco-provincia-text2"
        ]
    },

    "image#banco-provincia": {
        "props": {
            "blockClass": "logo-image-pagos",
            "src": "https://mundooutdoorar.vtexassets.com/arquivos/tarjetas-51.png",
            "maxWidth": "120px"
        }
    },

    "rich-text#banco-provincia-text1": {
        "props": {
            "blockClass": "logo-text-bold-pagos",
            "text": "Todos los días"
        }
    },

    "rich-text#banco-provincia-text2": {
        "props": {
            "blockClass": "logo-text-green-pagos",
            "text": "6 cuotas sin interés"
        }
    },


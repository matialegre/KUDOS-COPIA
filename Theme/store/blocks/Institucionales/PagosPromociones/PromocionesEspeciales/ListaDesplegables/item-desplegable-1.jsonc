{

    "disclosure-layout#item-promociones-especiales-1": {

        "children": [
            "disclosure-trigger#item-promociones-especiales-1", 
            "disclosure-content#item-promociones-especiales-1"
        ]

    },

    "disclosure-trigger#item-promociones-especiales-1": {

        "props": {
            "blockClass": "triger-dropdown-promociones-especiales",
            "as": "div"
        },

        "children": [
            "flex-layout.row#image-card-container-promociones-especiales-1",
            "rich-text#promociones-especiales-outstanding-question-1",
            "rich-text#promociones-especiales-question-1",
            "image#arrow-question"
        ]

    },

    "flex-layout.row#image-card-container-promociones-especiales-1": {

        "props": {
          "blockClass": "image-card-container",
          "preserveLayoutOnMobile": true,
          "horizontalAlign": "left",
          "colSizing": "auto"
        },
    
        "children": [
            "image#promociones-especiales-image-1"
        ]
    
    },

    "image#promociones-especiales-image-1": {

        "props": {
            "blockClass": "image-promociones-especiales",
            "src": "https://mundooutdoorar.vtexassets.com/arquivos/tarjetas-51.png"
        }

    },

    "rich-text#promociones-especiales-outstanding-question-1": {
        
        "props": {
            "blockClass": ["text-triger-dropdown-promociones-especiales", "cuotas"],
            "text": "Todos los días"
        }

    },

    "rich-text#promociones-especiales-question-1": {
        
        "props": {
            "blockClass": "text-triger-dropdown-promociones-especiales",
            "text": "6 cuotas sin interés"
        }

    },

    "disclosure-content#item-promociones-especiales-1": {

        "props": {
            "blockClass": "content-dropdown-promociones-especiales"
        },

        "children": [
            "rich-text#promociones-especiales-answer-1",
            "rich-text#promociones-especiales-answer-1a",
            "rich-text#promociones-especiales-answer-1b",
            "rich-text#promociones-especiales-answer-1c",
            "rich-text#promociones-especiales-answer-1d"
        ]

    },

    "rich-text#promociones-especiales-answer-1": {

        "props": {
            "blockClass": "text-content-dropdown-promociones-especiales",
            "text": "Visa / Master – Débito: 30% de descuento"
        }

    },

    "rich-text#promociones-especiales-answer-1a": {

        "props": {
            "blockClass": "text-content-dropdown-promociones-especiales",
            "text": "Visa / Master  – 1 cuota sin interés y 3 cuotas simples: 25% de descuento"
        }

    },

    "rich-text#promociones-especiales-answer-1b": {

        "props": {
            "blockClass": "text-content-dropdown-promociones-especiales",
            "text": "Visa / Master  – 6 cuotas simples: 20% de descuento"
        }

    },

    "rich-text#promociones-especiales-answer-1c": {

        "props": {
            "blockClass": "text-content-dropdown-promociones-especiales",
            "text": "Visa / Master  – 12 cuotas simples: 15% de descuento"
        }

    },

    "rich-text#promociones-especiales-answer-1d": {

        "props": {
            "blockClass": "text-content-dropdown-promociones-especiales",
            "text": "<span class=\"vtex-rich-text-0-x-outstanding--text-notify-pagos-promociones\">Promoción válida para los días Viernes y Sábados</span>"
        }

    }

}
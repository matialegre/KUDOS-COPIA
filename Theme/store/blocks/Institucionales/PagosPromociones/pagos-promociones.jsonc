{

    "store.custom#pagos-promociones": {
    
        "children":[
            "flex-layout.row#shared-container-pagos-promociones"
        ]

    },

    "flex-layout.row#shared-container-pagos-promociones": {

        "props": {
          "blockClass": "shared-container-constitucionales",
          "preserveLayoutOnMobile": true,
          "horizontalAlign": "left",
          "colSizing": "auto"
        },
    
        "children": [
            "flex-layout.col#shared-container-pagos-promociones-col"
        ]
    
    },

    "flex-layout.col#shared-container-pagos-promociones-col": {

        "props": {
          "blockClass": "shared-container-constitucionales-col",
          "preserveLayoutOnMobile": true,
          "horizontalAlign": "left",
          "colSizing": "auto"
        },
    
        "children": [
            "breadcrumb-custom",
            "rich-text#text-title-pagos-promociones",
            "rich-text#text-bold-pagos-promociones-1",
            "rich-text#text-plain-pagos-promociones-1",
            "rich-text#text-notify-pagos-promociones-1",
            "flex-layout.col#group-promociones-especiales-col",
            "rich-text#text-bold-pagos-promociones-2",
            "flex-layout.col#group-promociones-habituales-col",
            "rich-text#text-bold-pagos-promociones-3",
            "flex-layout.col#group-tarjetas-credito-col",
            "rich-text#text-bold-pagos-promociones-4",
            "flex-layout.col#group-tarjetas-debito-col",
            "rich-text#text-bold-pagos-promociones-5",
            "rich-text#text-plain-pagos-promociones-2",
            "flex-layout.col#group-otros-medio-pago-col"
        ]
    
    },

    "rich-text#text-title-pagos-promociones": {

        "props": {
            "blockClass": "text-title-institucionales",
            "text": "Pagos y promociones"
        }

    },

    "rich-text#text-bold-pagos-promociones-1": {

        "props": {
            "blockClass": ["text-bold-pagos-promociones", "first-of-type"],
            "text": "Promociones especiales"
        }

    },

    "rich-text#text-plain-pagos-promociones-1": {

        "props": {
            "blockClass": "text-plain-pagos-promociones",
            "text": "Hacé click en cada logo para conocer los detalles y vigencia de cada promoción."
        }

    },

    "rich-text#text-notify-pagos-promociones-1": {

        "props": {
            "blockClass": "text-notify-pagos-promociones",
            "text": "<span class=\"vtex-rich-text-0-x-span--text-notify-pagos-promociones\">*</span> La empresa se reserva el derecho de realizar modificaciones acerca de la vigencia o cualquier término y condición de las promociones vigentes.."
        }

    },

    "rich-text#text-bold-pagos-promociones-2": {

        "props": {
            "blockClass": "text-bold-pagos-promociones",
            "text": "Promociones Habituales"
        }

    },

    "rich-text#text-bold-pagos-promociones-3": {

        "props": {
            "blockClass": "text-bold-pagos-promociones",
            "text": "Tarjetas de crédito"
        }

    },

    "rich-text#text-bold-pagos-promociones-4": {

        "props": {
            "blockClass": "text-bold-pagos-promociones",
            "text": "Tarjetas de débito"
        }

    },

    "rich-text#text-bold-pagos-promociones-5": {

        "props": {
            "blockClass": "text-bold-pagos-promociones",
            "text": "Otros medios de pago"
        }

    },

    "rich-text#text-plain-pagos-promociones-2": {

        "props": {
            "blockClass": "text-plain-pagos-promociones",
            "text": "Hacé click en cada logo para conocer las condiciones legales."
        }

    }

}
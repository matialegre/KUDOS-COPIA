{

    "store.custom#venta-corporativa": {
    
        "children":[
            "flex-layout.row#shared-container-venta-corporativa",
            "flex-layout.row#venta-corporativa-banners-container",
            "support-entry"
        ]

    },

    "flex-layout.row#shared-container-venta-corporativa": {

        "props": {
          "blockClass": "shared-container-constitucionales",
          "preserveLayoutOnMobile": true,
          "horizontalAlign": "left",
          "colSizing": "auto"
        },
    
        "children": [
            "flex-layout.col#shared-container-venta-corporativa-col"
        ]
    
    },

    "flex-layout.col#shared-container-venta-corporativa-col": {

        "props": {
          "blockClass": "shared-container-constitucionales-col",
          "preserveLayoutOnMobile": true,
          "horizontalAlign": "left",
          "colSizing": "auto"
        },
    
        "children": [
            "breadcrumb-custom",
            "rich-text#text-title-venta-corporativa",
            "rich-text#text-plain-venta-corporativa-1",
            "flex-layout.col#form-venta-corporativa-container"
        ]
    
    },

    "rich-text#text-title-venta-corporativa": {

        "props": {
            "blockClass": "text-title-institucionales",
            "text": "Navegá nuestro catálogo y hacé tu pedido de cotización"
        }

    },

    "rich-text#text-plain-venta-corporativa-1": {

        "props": {
            "blockClass": "text-plain-venta-corporativa",
            "text": "Si deseas realizar una compra para tu empresa, completa el siguiente formulario con los detalles de los artículos que necesitas, y nos pondremos en contacto contigo a la brevedad."
        }

    }

}
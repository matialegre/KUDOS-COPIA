{

    "header-layout.desktop": {
        "children": [
            "sticky-layout#header-sticky",
            "brand-bar",
            "benefits-bar"
        ]
    },

    "sticky-layout#header-sticky": {
        "props": {
            "blockClass": "sticky-header"
        },
        "children": [
            "slider-layout#announcementBar",
            "flex-layout.row#utilityBar",
            "main-header#desktop"
        ]
    },

    "main-header#desktop": {
        "props": {
            "logo": "https://mundooutdoorar.vteximg.com.br/arquivos/logo_izq_arriba.png",
            "searchPlaceholder": "Buscar"
        }
    },

    "flex-layout.row#utilityBar": {

        "props": {
            "blockClass": "utilityBar",
            "horizontalAlign": "right",
            "verticalAlign": "center",
            "preserveLayoutOnMobile": false,
            "fullWidth": true
        },

        "children": [
            "flex-layout.row#utilityBarLeft",
            "utility-bar-right#desktop"
        ]

    },

    "flex-layout.row#utilityBarLeft": {

        "props": {
            "blockClass": "utilityLeft",
            "horizontalAlign": "left",
            "verticalAlign": "center"
        },

        "children": ["rich-text#utilityLinks"]

    },

    "rich-text#utilityLinks": {

        "props": {
            "blockClass": "utilityLinks",
            "text": "[Entregas](/) [Cambios](/) [Sucursales](/) [Preguntas frecuentes](/) [Ayuda](/)"
        }

    },

    "utility-bar-right#desktop": {
        "props": {
            "blockClass": "desktop-utility-bar",
            "items": [
                {
                    "id": "stores",
                    "label": "Ver sucursales",
                    "href": "/sucursales",
                    "icon": "https://mundooutdoorar.vteximg.com.br/arquivos/icono_ubicacion.png",
                    "ariaLabel": "Ver sucursales"
                },
                {
                    "id": "shipping",
                    "label": "Envíos",
                    "href": "/institucional/envios",
                    "icon": "https://mundooutdoorar.vteximg.com.br/arquivos/icono_camion_negro.png",
                    "ariaLabel": "Información de envíos"
                },
                {
                    "id": "account",
                    "label": "Mi cuenta",
                    "href": "/account",
                    "icon": "https://mundooutdoorar.vteximg.com.br/arquivos/icono_persona.png",
                    "ariaLabel": "Acceder a Mi cuenta"
                },
                {
                    "id": "cart",
                    "label": "",
                    "href": "/checkout/#/cart",
                    "icon": "https://mundooutdoorar.vteximg.com.br/arquivos/icono_chango_negro.png",
                    "ariaLabel": "Ver carrito"
                }
            ]
        }
    },
    "flex-layout.row#containerRowHeaderDesktop": {
        "props": {
            "blockClass": "container-row-header-desktop",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "left",
            "colSizing": "auto"
        },
        "children": [
            "logo",
            "menu-kudos",
            // "search-bar",
            // "rich-text#menu",
            "search-bar-custom",
            "login",
            // "minicart.v2"
            "mini-cart-custom"
        ]
    },
    "mini-cart-custom": {
        "props": {
            "MiniCart": "minicart.v2"
        }
    },
    "slider-layout#announcementBar": {
        "props": {
            "blockClass": "announcement-carousel",
            "itemsPerPage": {
                "desktop": 1,
                "tablet": 1,
                "phone": 1
            },
            "infinite": true,
            "autoplay": {
                "timeout": 4000,
                "stopOnHover": true
            },
            "showPaginationDots": "never"
        },
        "children": [
            "rich-text#announcementMessageTruck",
            "rich-text#announcementMessagePromo1",
            "rich-text#announcementMessagePromo2"
        ]
    },

    "rich-text#announcementMessageTruck": {
        "props": {
            "blockClass": "announcement-message-with-truck",
            "text": "ENVÍO GRATIS EN COMPRAS MAYORES A $150.000"
        }
    },

    "rich-text#announcementMessagePromo1": {
        "props": {
            "blockClass": "announcement-message",
            "text": "3 Y 6 CUOTAS SIN INTERÉS"
        }
    },

    "rich-text#announcementMessagePromo2": {
        "props": {
            "blockClass": "announcement-message",
            "text": "HASTA 50% OFF EN PRODUCTOS SELECCIONADOS"
        }
    },

    "rich-text#menu": {
        "props": {
            "blockClass": "aqui-menu",
            "text": "aqui va el menu"
        }
    },

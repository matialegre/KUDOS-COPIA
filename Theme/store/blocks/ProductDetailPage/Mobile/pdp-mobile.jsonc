    "flex-layout.row#stickyBuyPdp": {

        "props": {
            "blockClass": "sticky-buy-pdp"
        },

        "children": [
            "product-quantity#mobile",
            "vtex.store-components:buy-button"
        ]

    },

    "product-quantity#mobile": {
        "props": {
            "selectorType": "dropdown",
            "showUnit": false
        }
    }

}
   "shelf.relatedProducts": {
    "blocks": ["product-summary.shelf#product-box"],
    "props": {
      "blockClass": [
        "related",
        "product-box"
      ],
      "recommendation": "view",
      "isFullModeStyle": true,
      "paginationDotsVisibility": "visible",
      "productList": {
        "minItemsPerPage": 2,
        "itemsPerPage": 4,
        "scroll": "ONE_BY_ONE",
        "arrows": true,
        "titleText": ""
      }
    }
  }

}
                }
                
            ]

        },

        "children": ["slider-layout#slider-banner-solo-imagenes"]
        
    },
    
    "slider-layout#slider-banner-solo-imagenes": {
        
        "props": {
            
            "blockClass": "slider-banner-solo-imagenes",
            "itemsPerPage": {
                "desktop": 1,
                "tablet": 1,
                "phone": 1
            },
            "infinite": true,
            "autoplay": {
                "timeout": 8000,
                "stopOnHover": false
            },
            "showPaginationDots": "always", // desktopOnly | mobileOnly | always | never
            "showNavigationArrows": "desktopOnly" // desktopOnly | mobileOnly | always | never
            
        }

    }
}
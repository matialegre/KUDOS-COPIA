                },

                {
                    "image": "https://mundooutdoorar.vtexassets.com/assets/vtex.file-manager-graphql/images/370d69c1-e1dd-4f96-9670-9e2efa0e5dc5___5c6dc7b09404600ae68c9e5834820a88.png",
                    "mobileImage": "https://mundooutdoorar.vtexassets.com/assets/vtex.file-manager-graphql/images/370d69c1-e1dd-4f96-9670-9e2efa0e5dc5___5c6dc7b09404600ae68c9e5834820a88.png"
                },

                {
                    "image": "https://mundooutdoorar.vtexassets.com/assets/vtex.file-manager-graphql/images/096591cd-1146-4532-8cb1-e8a5de0f02d1___95906a12edf947a5fad698436a7107e6.png",

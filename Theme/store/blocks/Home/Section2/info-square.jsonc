{
    "flex-layout.row#infoSquareContainer": {
        "props": {
            "blockClass": "info-square-container",
            "preserveLayoutOnMobile": false,
            "horizontalAlign": "left",
            "colSizing": "auto"
        },
        "children": [
            "flex-layout.row#gradientSlider",
            "slider-layout#infoSquareSlider"
        ]
    },

    "flex-layout.row#gradientSlider": {
        "props": {
            "blockClass": "gradient-slider",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "left",
            "colSizing": "auto"
        }
    },

    "slider-layout#infoSquareSlider": {
        "props": {
            "blockClass": "info-square-slider",
            "itemsPerPage": {
                "desktop": 4,
                "tablet": 2,
                "phone": 2
            },
            "infinite": true,
            "autoplay": {
                "timeout": 5000,
                "stopOnHover": true
            },
            "showNavigationArrows": "never",
            "showPaginationDots": "never"
        },
        "children": [
            "flex-layout.row#itemSquare1",
            "flex-layout.row#itemSquare2",
            "flex-layout.row#itemSquare3",
            "flex-layout.row#itemSquare4"
        ]
    },

    "benefit-slider-mobile#promos": {
        "props": {
            "benefits": [
                {
                    "image": "/arquivos/promos%20celu-27%20(1).png",
                    "alt": "Promoción 1",
                    "link": "/pagos-y-promociones"
                },
                {
                    "image": "/arquivos/promos%20celu-30%20(1).png",
                    "alt": "Promoción 2",
                    "link": "/pagos-y-promociones"
                },
                {
                    "image": "/arquivos/promos%20celu-29%20(1).png",
                    "alt": "Promoción 3",
                    "link": "/pagos-y-promociones"
                },
                {
                    "image": "/arquivos/promos%20celu-28%20(1).png",
                    "alt": "Promoción 4",
                    "link": "/pagos-y-promociones"
                }
            ]
        }
    }
}
{

    "flex-layout.row#itemSquare3": {

        "props": {
            "blockClass": "item-square",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "left",
            "colSizing": "auto"
        },

        "children": [
            "image#imageItemSquare3"
        ]
    
    },

    "image#imageItemSquare3":{

        "props": {
            "blockClass": "image-item-square",
            "src": "/arquivos/benefit-card-6cuotas-fijas.png",
            "link": {
                "url": "/institucional/medios-de-pago"
            }
        }

    }

}
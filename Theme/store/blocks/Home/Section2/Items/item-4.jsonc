{

    "flex-layout.row#itemSquare4": {

        "props": {
            "blockClass": "item-square",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "left",
            "colSizing": "auto"
        },

        "children": [
            "image#imageItemSquare4"
        ]

    },

    "image#imageItemSquare4": {

        "props": {
            "blockClass": "image-item-square",
            "src": "/arquivos/benefit-card-envio-gratis.png",
            "link": {
                "url": "/institucional/envios"
            }
        }

    }

}
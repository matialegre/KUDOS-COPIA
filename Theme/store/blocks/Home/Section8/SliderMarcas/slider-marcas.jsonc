    "slider-layout#slider-marcas-solo-imagenes": {
        "props": {
            "blockClass": "slider-marcas-solo-imagenes",
            "itemsPerPage": {
                "desktop": 8,
                "tablet": 4,
                "phone": 3
            },
            "showPaginationDots": "always",
            "infinite": true,
            "fullWidth": true,
            "showNavigationArrows": "always",
            "autoplay": {
                "timeout": 3000,
                "stopOnHover": true
            }
        }
    }

{

    "flex-layout.row#tendenciasContainer": {

        "props": {
            "blockClass": "tendencias-container",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "left",
            "colSizing": "auto"
        },

        "children": [
            "flex-layout.col#tendenciasCol"
        ]

    },

    "flex-layout.col#tendenciasCol": {

        "props": {
            "blockClass": "tendencias-col",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "center",
            "colSizing": "auto"
        },

        "children": [
            "rich-text#title-tendencias",
            "flex-layout.row#tendenciasImagesRow",
            "slider-layout#tendenciasMobile"
        ]
    
    },

    "rich-text#title-tendencias": {

        "props": {
            "blockClass": "title-tendencias",
            "text": "TENDENCIAS"
        }

    },

    "flex-layout.row#tendenciasImagesRow": {

        "props": {
            "blockClass": "tendencias-images-row",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "center",
            "colSizing": "auto"
        },

        "children": [
            "image#tendenciasDC",
            "image#tendenciasRoxy",
            "image#tendenciasSalomon"
        ]

    },

    "image#tendenciasDC": {

        "props": {
            "blockClass": "tendencias-image",
            "src": "/arquivos/tendencias-dc.jpg",
            "link": {
                "url": "/marcas/dc"
            }
        }

    },

    "image#tendenciasRoxy": {

        "props": {
            "blockClass": "tendencias-image",
            "src": "/arquivos/imagne_web_roxy_comprimido.jpg",
            "link": {
                "url": "/marcas/roxy"
            }
        }

    },

    "image#tendenciasSalomon": {

        "props": {
            "blockClass": "tendencias-image",
            "src": "/arquivos/tendencias-salomon.jpg",
            "link": {
                "url": "/marcas/salomon"
            }
        }

    },

    "slider-layout#tendenciasMobile": {
        "props": {
            "blockClass": "tendencias-mobile-slider",
            "itemsPerPage": {
                "desktop": 1,
                "tablet": 1,
                "phone": 1
            },
            "infinite": true,
            "autoplay": {
                "timeout": 4000,
                "stopOnHover": true
            },
            "showPaginationDots": "always",
            "showNavigationArrows": "always"
        },
        "children": [
            "image#tendenciasDCMobile",
            "image#tendenciasRoxyMobile",
            "image#tendenciasSalomonMobile"
        ]
    },

    "image#tendenciasDCMobile": {
        "props": {
            "blockClass": "tendencias-mobile-image",
            "src": "/arquivos/tendencia-12-1221.jpg",
            "link": {
                "url": "/marcas/dc"
            }
        }
    },

    "image#tendenciasRoxyMobile": {
        "props": {
            "blockClass": "tendencias-mobile-image",
            "src": "/arquivos/tendencia-12-1331.jpg",
            "link": {
                "url": "/marcas/roxy"
            }
        }
    },

    "image#tendenciasSalomonMobile": {
        "props": {
            "blockClass": "tendencias-mobile-image",
            "src": "/arquivos/tendencia-12-14-1441.jpg",
            "link": {
                "url": "/marcas/salomon"
            }
        }
    }

}

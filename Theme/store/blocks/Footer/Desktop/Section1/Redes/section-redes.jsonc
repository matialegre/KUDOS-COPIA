{

    "flex-layout.col#sectionRedes": {

        "props": {
            "blockClass": "section-redes",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "left",
            "colSizing": "auto"
        },

        "children": [
            "rich-text#title-redes",
            "flex-layout.row#itemsRedes"
        ]
    
    },

    "rich-text#title-redes": {

        "props": {
            "blockClass": "title-footer",
            "text": "Redes"
        }

    },

    "flex-layout.row#itemsRedes": {

        "props": {
            "blockClass": "items-redes",
            "preserveLayoutOnMobile": true,
            "horizontalAlign": "left",
            "colSizing": "auto"
        },

        "children": [
            "image#imageInstagram",
            "image#imageFacebook",
            "image#imageTiktok"
        ]
    
    },

    "image#imageInstagram": {

        "props": {
            "blockClass": "link-redes-footer",
            "src": "https://mundooutdoorar.vtexassets.com/arquivos/ICONOS%20REDES-INSTA.png",
            "link":{
                "url": "https://www.instagram.com/",
                "newTab": true
            }
        }

    },

    "image#imageFacebook": {

        "props": {
            "blockClass": "link-redes-footer",
            "src": "https://mundooutdoorar.vtexassets.com/arquivos/ICONOS%20REDES-FB.png",
            "link":{
                "url": "https://www.facebook.com/",
                "newTab": true
            }
        }

    },

    "image#imageTiktok": {

        "props": {
            "blockClass": "link-redes-footer",
            "src": "https://mundooutdoorar.vtexassets.com/arquivos/ICONOS%20REDES-TIKTOK.png",
            "link":{
                "url": "www.tiktok.com",
                "newTab": true
            }
        }

    }

}
{

    "search-result-layout.desktop": {

        "props": {

            "hiddenFilters": {
                "hideAll": true
            },
            "hiddenFacets": {
                "specificationFilters": {
                    "hiddenFilters": ["Actividad", "actividad"]
                }
            },
            "pagination": "show-more",
            "preventRouteChange": false,
            "mobileLayout": {
                "mode1": "small",
                "mode2": "normal"
            }

        },

        "children": [
            // "search-banner#one",
            "flex-layout.row#result"
        ]

    },
    
    "flex-layout.row#result": {

        "props": {
            "blockClass": "list-product-cont",
            "preventVerticalStretch": true,
            "rowGap": 0
        },

        "children": [
            "flex-layout.col#filter", 
            "flex-layout.col#content"
        ]
        
    },

    // "search-banner#one": {

    //     "props": {
    //         "area": "one",
    //         "blockClass": "banner-clinicus-department",
    //         "horizontalAlignment": "center"
    //     }

    // },
    
    "flex-layout.col#filter": {

        "props": {
            "blockClass": "filterCol",
            "width": "251px",
            "rowGap": 0,
            "marginRight": 4
        },

        "children": [
            // "breadcrumb.search",
            "filter-navigator.v3"
        ]

    },
    
    "flex-layout.col#content": {
        "children": [
            "flex-layout.row#searchinfo",
            // "flex-layout.row#fetchprevious",
            "flex-layout.row#products",
            "flex-layout.row#fetchmoreContainer"
        ],
        "props": {
            "blockClass": "list-product-col",
            "preventVerticalStretch": true,
            "marginLeft": 4
        }
    },

    "flex-layout.row#searchinfo": {

        "props": {
            "blockClass": "search-info"
        },

        "children": [
            // "flex-layout.col#breadcrumb",
            "flex-layout.col#orderby"
        ]

    },
    
    "flex-layout.col#breadcrumb": {
        "children": ["total-products.v2"],
        "props": {
            "blockClass": "productCountCol"
        }
    },
    
    "breadcrumb.search": {
        "props": {
            "blockClass": "list-prod-breadcrumb",
            "showOnMobile": true
        }
    },
    
    "flex-layout.col#orderby": {
        
        "props": {
            "blockClass": "orderByCol"
        },

        "children": [
            "total-products.v2",
            "order-by.v2"
        ]

    },
    
    "flex-layout.row#fetchprevious": {
        "props": {
            "marginBottom": 3
        },
        "children": ["search-fetch-previous"]
    },
    
    "flex-layout.row#fetchmoreContainer": {
        "props": {
            "blockClass": "fetchmore-container",
            "marginTop": 3
        },
        "children": [
            "search-products-count-per-page",
            "search-fetch-more"
        ]
    },
    
    "flex-layout.row#products": {
        "props": {
            "blockClass": "product-list"
        },
        "children": ["search-content"]
    },
    
    "search-content": {
        "blocks": ["gallery#gallery", "not-found"]
    },

    "gallery#gallery": {

        "props": {

            "layouts": [

                {
                    "name": "many",
                    "component": "ManyByLineSummary",
                    "itemsPerRow": {
                        "desktop": 4,
                        "mobile": 2
                    }
                }
                
            ],

            "ManyByLineSummary": "product-summary.shelf#product-box"

        }
    }

}
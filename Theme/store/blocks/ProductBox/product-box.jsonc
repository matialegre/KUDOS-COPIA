{

  "product-summary.shelf#product-box": {

      "props":{
        // "blockclass": "product-summary-container"
        "blockclass": "product-box"
      },
  
      "children": [
          "flex-layout.row#sectionImageAndCucardasContainer",
          "product-summary-brand",
          "product-summary-name",
          "product-rating-inline",
          "product-summary-price#custom",
          "product-installments",
          // "rich-text#envio-gratis",
          "envio-gratis",
          "flex-layout.row#skuSelectorColorContainer",
          "select-sku-in-product-box"
      ]
      
  },

  "flex-layout.row#sectionImageAndCucardasContainer": {

      "props": {
          "blockClass": "section-image-and-cucardas-container",
          "preserveLayoutOnMobile": true,
          "horizontalAlign": "left",
          "colSizing": "auto"
      },

      "children": [
          "flex-layout.row#cucardasContainer",
          "flex-layout.row#skuSelectorTallesContainer",
          "product-summary-image"
      ]
  
  },

  "flex-layout.row#cucardasContainer": {

      "props": {
          "blockClass": "cucardas-container",
          "preserveLayoutOnMobile": true,
          "horizontalAlign": "left",
          "colSizing": "auto"
      },

      "children": [
          "product-price-savings"
      ]
  
  },

  "product-price-savings": {

    "props": {
      "percentageStyle": "compact",
      "message": "{savingsPercentage}"
    }
        
  },

  "product-summary-image": {

    "props": {
      "showBadge": false
      // "showCollections": true,
      // "hoverImage":{
      //   "criteria":"index",
      //   "index": 1
      // }
    }

  },

  "rich-text#envio-gratis": {

    "props": {
      "blockClass": "envio-gratis-product-box",
      "text": "Envío Gratis"
    }

  },

  "flex-layout.row#skuSelectorTallesContainer": {

    "props": {
      "blockClass": "sku-selector-talles-container"
    },

    "children": [ 
      
    ]

  },

  "flex-layout.row#skuSelectorColorContainer": {

    "props": {
      "blockClass": "sku-selector-color-container"
    },

    "children": [ 
      
    ]

  },

  "select-sku-in-product-box": {

    "props": {
      "AddToCartButton": "add-to-cart-button"
    }

  },

  "product-summary-price#custom": {
    "props": {
      "showListPrice": true,
      "showLabels": false,
      "showInstallments": false,
      "showSavings": false,
      "installmentsCriteria": "max-quantity-without-interest",
      "installmentMessage": "{installmentsNumber} cuotas sin interés de {installmentsValue}",
      "markers": ["discount"]
    }
  }

}